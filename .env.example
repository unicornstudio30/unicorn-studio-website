# Google Apps Script web app URL for the contact form.
# Deployed under saidur@unicornstudio.io. Forwards submissions to
# the email defined in scripts/contact-form.gs (RECIPIENT constant).
#
# Without this set, the form falls back to opening the visitor's
# mail client (still works, just less polished).
NEXT_PUBLIC_FORM_ENDPOINT=https://script.google.com/macros/s/PASTE_DEPLOYMENT_ID_HERE/exec
