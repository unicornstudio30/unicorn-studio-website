# =============================================================================
# Contact form
# =============================================================================
# Delivery is handled by Web3Forms (api.web3forms.com). The access key is
# hard-coded in components/CTA.tsx because Web3Forms keys are public by
# design (they only authorize submissions to the email on the dashboard).
# Manage / rotate at: https://web3forms.com/dashboard
#
# No env vars required for the form to work.

# =============================================================================
# Hostinger deployment — used by scripts/deploy-hostinger.sh
# =============================================================================
# Find each value in hPanel → Files → FTP Accounts.

HOSTINGER_FTP_HOST=ftp.unicornstudio.io
HOSTINGER_FTP_USER=u123456789
HOSTINGER_FTP_PASSWORD=
HOSTINGER_FTP_PORT=21
HOSTINGER_REMOTE_PATH=/public_html

# Optional — defaults shown.
# HOSTINGER_PROTOCOL=ftp           # ftp | sftp | ftps
# HOSTINGER_FTP_SSL_FORCE=no       # set to "yes" for FTPS
# HOSTINGER_PUBLIC_URL=https://unicornstudio.io
